# Optional. When set, saving (Update numbers, Days off, team changes, Close month, Undo) asks for this key once per browser.
# Set it in Vercel → Project → Settings → Environment Variables. Locally: EDITOR_KEY=... npm run dev
EDITOR_KEY=

# Set automatically by Vercel when you connect a Blob store (Storage → Create → Blob → Connect to project).
# Without it the deployed dashboard is read-only.
BLOB_READ_WRITE_TOKEN=

# Only if your Blob store was created as "public" instead of "private".
# BLOB_ACCESS=public

# Only to point the frontend at a json-server hosted elsewhere (default: /api on the same site).
# VITE_API_URL=https://my-json-server.example.com/api
